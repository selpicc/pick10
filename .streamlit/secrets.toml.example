# Streamlit Cloud 비밀키 템플릿 (예시 파일)
# ─────────────────────────────────────────────────────────────
# 이 파일은 '형식만' 보여주는 예시입니다. 실제 키는 여기 적지 말고,
# Streamlit Cloud 배포 시 [Advanced settings → Secrets] 칸에
# 아래 형식 그대로 '실제 값'을 붙여넣으세요.
#
# (로컬에서 테스트하려면 같은 폴더에 secrets.toml 로 복사 후 실제값 입력 —
#  단, secrets.toml 은 .gitignore 로 보호되어 GitHub에 올라가지 않음)

SUPABASE_URL = "https://여기에-실제-supabase-url"
SUPABASE_KEY = "여기에-실제-supabase-anon-key"

# 대시보드 접속 비밀번호 (공개 URL 보호용 — 꼭 설정 권장)
APP_PASSWORD = "원하는-비밀번호"

# 수집용 (선택 — 클라우드에선 수집 안 함. 안 넣어도 보기/메일은 작동)
NAVER_CLIENT_ID = ""
NAVER_CLIENT_SECRET = ""
